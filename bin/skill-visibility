#!/usr/bin/env python3
"""Claude/Codex から見える Skill を正本と symlink 宣言で管理する。"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from datetime import datetime
from pathlib import Path
from typing import NamedTuple


AGENT_ARRAYS = {"claude": "CLAUDE_SKILLS", "codex": "CODEX_SKILLS"}
IGNORED_DIRS = {"__pycache__"}
IGNORED_FILES = {".DS_Store"}
NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*$")
SKILL_MANAGER = Path.home() / ".local/bin/hermes-codex-skill"
ALLOWED_ACTIONS = {"enable", "disable", "promote", "delete", "delete-canonical", "audit"}
STATUS_COLOR_PAIRS = {
    "canonical-link": 2,
    "agent-specific": 3,
    "agent-specific-divergent": 4,
}
PLAN_SCHEMA = {
    "type": "object",
    "properties": {
        "operations": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "action": {"enum": sorted(ALLOWED_ACTIONS)},
                    "agent": {"enum": [*sorted(AGENT_ARRAYS), None]},
                    "skill": {"type": ["string", "null"]},
                    "keep_divergent": {"type": ["boolean", "null"]},
                },
                "required": ["action", "agent", "skill", "keep_divergent"],
                "additionalProperties": False,
            },
        },
        "explanation": {"type": "string"},
    },
    "required": ["operations", "explanation"],
    "additionalProperties": False,
}


class SkillVisibilityError(RuntimeError):
    pass


class PromotionConflict(SkillVisibilityError):
    pass


class MatrixRow(NamedTuple):
    name: str
    canonical: bool
    claude: str
    codex: str
    owner: str = "user"
    created: str = "-"
    modified: str = "-"


def _array_pattern(name: str) -> re.Pattern[str]:
    return re.compile(rf"(^[ \t]*{re.escape(name)}=\(\n)(.*?)(^\))", re.M | re.S)


def read_declarations(script: Path) -> dict[str, list[str]]:
    text = script.read_text(encoding="utf-8")
    result = {}
    for array_name in AGENT_ARRAYS.values():
        match = _array_pattern(array_name).search(text)
        if not match:
            raise SkillVisibilityError(f"宣言配列が見つかりません: {array_name}")
        result[array_name] = [
            line.strip()
            for line in match.group(2).splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    return result


def _write_declaration(script: Path, array_name: str, names: list[str]) -> None:
    text = script.read_text(encoding="utf-8")
    pattern = _array_pattern(array_name)
    match = pattern.search(text)
    if not match:
        raise SkillVisibilityError(f"宣言配列が見つかりません: {array_name}")
    body = "".join(f"  {name}\n" for name in sorted(set(names)))
    script.write_text(
        text[: match.start()] + match.group(1) + body + match.group(3) + text[match.end() :],
        encoding="utf-8",
    )


def _validate_skill(root: Path, name: str) -> None:
    if not NAME_PATTERN.fullmatch(name):
        raise SkillVisibilityError(f"不正な Skill 名です: {name}")
    if not (root / "link-skills.sh").is_file():
        raise SkillVisibilityError(f"dotfiles root ではありません: {root}")


def _validate(root: Path, agent: str, name: str) -> None:
    if agent not in AGENT_ARRAYS:
        raise SkillVisibilityError(f"未対応の agent です: {agent}")
    _validate_skill(root, name)


def _skill_files(path: Path) -> dict[str, bytes | str]:
    files: dict[str, bytes | str] = {}
    for current, directories, filenames in os.walk(path, followlinks=False):
        directories[:] = sorted(name for name in directories if name not in IGNORED_DIRS)
        current_path = Path(current)
        for filename in sorted(filenames):
            if filename in IGNORED_FILES or filename.endswith(".pyc"):
                continue
            item = current_path / filename
            relative = item.relative_to(path).as_posix()
            files[relative] = f"symlink:{os.readlink(item)}" if item.is_symlink() else item.read_bytes()
    return files


def same_skill_contents(left: Path, right: Path) -> bool:
    return _skill_files(left) == _skill_files(right)


def differing_skill_files(left: Path, right: Path) -> list[str]:
    left_files = _skill_files(left)
    right_files = _skill_files(right)
    return sorted(
        name
        for name in left_files.keys() | right_files.keys()
        if left_files.get(name) != right_files.get(name)
    )


def _children(path: Path) -> set[str]:
    if not path.is_dir():
        return set()
    return {
        child.name
        for child in path.iterdir()
        if not child.name.startswith(".")
        and (child.is_symlink() or (child.is_dir() and (child / "SKILL.md").is_file()))
    }


def _agent_status(root: Path, agent: str, name: str, canonical: Path) -> str:
    target = root / agent / "skills" / name
    if not target.exists() and not target.is_symlink():
        return "off"
    if target.is_symlink():
        try:
            if target.resolve(strict=True) == canonical.resolve(strict=True):
                return "canonical-link"
        except FileNotFoundError:
            pass
        raise SkillVisibilityError(f"正本を指さない symlink です: {target}")
    if not (target / "SKILL.md").is_file():
        raise SkillVisibilityError(f"SKILL.md がありません: {target}")
    if canonical.is_dir() and not same_skill_contents(target, canonical):
        return "agent-specific-divergent"
    return "agent-specific"


def _skill_owner_map(rows: object) -> dict[str, str] | None:
    if not isinstance(rows, list):
        return None
    return {
        str(row["name"]): str(row["owner"])
        if row.get("owner") in {"agent", "user", "external"}
        else "unknown"
        for row in rows
        if isinstance(row, dict) and isinstance(row.get("name"), str)
    }


def skill_owners(root: Path) -> dict[str, str] | None:
    configured_root = Path(os.environ.get("DOTFILES", Path.home() / "dotfiles")).expanduser().resolve()
    if root.resolve() != configured_root:
        return {}
    try:
        result = subprocess.run(
            [str(SKILL_MANAGER), "list", "--json"],
            text=True,
            capture_output=True,
            timeout=2,
        )
        rows = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        return None
    return _skill_owner_map(rows)


def _creation_timestamp(stat: object) -> float | None:
    return getattr(stat, "st_birthtime", None)


def _skill_dates(paths: list[Path]) -> tuple[str, str]:
    created = []
    modified = []
    for path in paths:
        items = [path, *(item for item in path.rglob("*") if not item.is_symlink())]
        for index, item in enumerate(items):
            try:
                stat = item.stat()
            except OSError:
                continue
            if index == 0 and (timestamp := _creation_timestamp(stat)) is not None:
                created.append(timestamp)
            modified.append(stat.st_mtime)
    if not modified:
        return "-", "-"
    date = lambda timestamp: datetime.fromtimestamp(timestamp).strftime("%Y-%m-%d")
    return date(min(created)) if created else "-", date(max(modified))


def build_matrix(root: Path) -> list[MatrixRow]:
    canonical_root = root / "skills"
    owners = skill_owners(root)
    names = _children(canonical_root)
    for agent in AGENT_ARRAYS:
        names |= _children(root / agent / "skills")
    rows = []
    for name in sorted(names):
        canonical = canonical_root / name
        has_canonical = canonical.is_dir() and (canonical / "SKILL.md").is_file()
        sources = [canonical] if has_canonical else [
            root / agent / "skills" / name
            for agent in AGENT_ARRAYS
            if (root / agent / "skills" / name).is_dir()
            and not (root / agent / "skills" / name).is_symlink()
        ]
        created, modified = _skill_dates(sources)
        rows.append(
            MatrixRow(
                name,
                has_canonical,
                _agent_status(root, "claude", name, canonical),
                _agent_status(root, "codex", name, canonical),
                "user" if not has_canonical else "unknown" if owners is None else owners.get(name, "user"),
                created,
                modified,
            )
        )
    return rows


def matrix_to_json(rows: list[MatrixRow]) -> list[dict[str, object]]:
    return [
        {
            "name": row.name,
            "canonical": row.canonical,
            "claude": row.claude,
            "codex": row.codex,
            "owner": row.owner,
            "created": row.created,
            "modified": row.modified,
        }
        for row in rows
    ]


def filter_rows(rows: list[MatrixRow], query: str) -> list[MatrixRow]:
    needle = query.casefold().strip()
    return rows if not needle else [row for row in rows if needle in row.name.casefold()]


def page_target(selected: int, direction: int, item_count: int, screen_height: int) -> int:
    step = max(1, (screen_height - 5) // 2)
    return min(max(0, selected + direction * step), max(0, item_count - 1))


def vim_jump(key: int, waiting_for_g: bool, item_count: int) -> tuple[int | None, bool]:
    if key == ord("g"):
        return (0, False) if waiting_for_g else (None, True)
    if key == ord("G"):
        return max(0, item_count - 1), False
    return None, False


def skill_folder(root: Path, row: MatrixRow, agent: str) -> Path:
    if getattr(row, agent).startswith("agent-specific"):
        return root / agent / "skills" / row.name
    if row.canonical:
        return root / "skills" / row.name
    for other_agent in AGENT_ARRAYS:
        candidate = root / other_agent / "skills" / row.name
        if candidate.is_dir():
            return candidate
    raise SkillVisibilityError(f"Skillフォルダが見つかりません: {row.name}")


def read_skill_description(folder: Path) -> str:
    lines = (folder / "SKILL.md").read_text(encoding="utf-8").splitlines()
    if not lines or lines[0].strip() != "---":
        return "説明なし"
    for index, line in enumerate(lines[1:], 1):
        if line.strip() == "---":
            break
        match = re.match(r"^description:\s*(.*)$", line)
        if not match:
            continue
        value = match.group(1).strip()
        if value in ("|", ">"):
            block = []
            for continuation in lines[index + 1 :]:
                if continuation and not continuation[0].isspace():
                    break
                block.append(continuation.strip())
            value = " ".join(block)
        elif len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        return " ".join(value.split()) or "説明なし"
    return "説明なし"


def _display_width(text: str) -> int:
    return sum(
        0 if unicodedata.combining(character) else 2 if unicodedata.east_asian_width(character) in "WF" else 1
        for character in text
    )


def _take_display_line(text: str, width: int) -> tuple[str, str]:
    used = 0
    end = 0
    last_space = -1
    for end, character in enumerate(text):
        character_width = _display_width(character)
        if used + character_width > width:
            break
        used += character_width
        if character.isspace():
            last_space = end
    else:
        return text, ""
    split = end if text[end].isspace() else last_space if last_space > 0 else end
    return text[:split].rstrip(), text[split:].lstrip()


def description_lines(description: str, width: int, limit: int = 2) -> list[str]:
    remaining = " ".join(description.split())
    result = []
    for _ in range(limit):
        line, remaining = _take_display_line(remaining, width)
        result.append(line)
        if not remaining:
            return result
    if result and remaining:
        while result[-1] and _display_width(result[-1] + "…") > width:
            result[-1] = result[-1][:-1].rstrip()
        result[-1] += "…"
    return result


def actions_for(row: MatrixRow, agent: str) -> list[str]:
    status = getattr(row, agent)
    if row.canonical and status == "off":
        return ["enable"]
    if status == "canonical-link":
        return ["disable"]
    if status.startswith("agent-specific"):
        return ([] if row.canonical else ["promote"]) + ["delete"]
    return []


def validate_operations(operations: object) -> list[dict[str, object]]:
    if not isinstance(operations, list):
        raise SkillVisibilityError("Agent計画の operations は配列である必要があります")
    validated = []
    for operation in operations:
        if not isinstance(operation, dict):
            raise SkillVisibilityError("Agent計画の操作はobjectである必要があります")
        action = operation.get("action")
        if action not in ALLOWED_ACTIONS:
            raise SkillVisibilityError(f"未対応の操作です: {action}")
        if set(operation) - {"action", "agent", "skill", "keep_divergent"}:
            raise SkillVisibilityError("Agent計画に未対応のfieldがあります")
        if action == "audit":
            validated.append({"action": "audit"})
            continue
        skill = operation.get("skill")
        if not isinstance(skill, str) or not NAME_PATTERN.fullmatch(skill):
            raise SkillVisibilityError(f"不正な Skill 名です: {skill}")
        keep_divergent = operation.get("keep_divergent") or False
        if not isinstance(keep_divergent, bool):
            raise SkillVisibilityError("keep_divergent はbooleanである必要があります")
        if action == "delete-canonical":
            if operation.get("agent") is not None:
                raise SkillVisibilityError("正本削除に agent は指定できません")
            if keep_divergent:
                raise SkillVisibilityError("keep_divergent はpromoteでのみ指定できます")
            validated.append({"action": action, "skill": skill})
            continue
        agent = operation.get("agent")
        if agent not in AGENT_ARRAYS:
            raise SkillVisibilityError(f"未対応の agent です: {agent}")
        normalized = {"action": action, "agent": agent, "skill": skill}
        if action == "promote":
            normalized["keep_divergent"] = keep_divergent
        elif keep_divergent:
            raise SkillVisibilityError("keep_divergent はpromoteでのみ指定できます")
        validated.append(normalized)
    return validated


def _state_fingerprint(root: Path) -> str:
    digest = hashlib.sha256()
    paths = [root / "link-skills.sh", root / "skills", root / "claude/skills", root / "codex/skills"]
    for base in paths:
        if not base.exists() and not base.is_symlink():
            digest.update(f"missing:{base.relative_to(root)}".encode())
            continue
        items = [base] if not base.is_dir() else [base, *sorted(base.rglob("*"))]
        for item in items:
            relative = item.relative_to(root).as_posix()
            if item.is_symlink():
                digest.update(f"link:{relative}:{os.readlink(item)}".encode())
            elif item.is_file():
                digest.update(f"file:{relative}:".encode())
                digest.update(item.read_bytes())
            else:
                digest.update(f"dir:{relative}".encode())
    return digest.hexdigest()


def _default_audit(root: Path) -> str:
    env = os.environ.copy()
    env["DOTFILES"] = str(root)
    result = subprocess.run(
        [str(root / "link-skills.sh"), "--audit"],
        cwd=root,
        env=env,
        text=True,
        capture_output=True,
    )
    if result.returncode:
        raise SkillVisibilityError(result.stderr.strip() or result.stdout.strip() or "監査に失敗しました")
    return result.stdout.strip()


def _snapshot_operation_state(
    root: Path,
    operations: list[dict[str, object]],
    backup: Path,
) -> tuple[str, dict[Path, tuple[str, object]]]:
    names = sorted({str(item["skill"]) for item in operations if item["action"] != "audit"})
    paths = [root / base / name for name in names for base in ("skills", "claude/skills", "codex/skills")]
    states = {}
    for index, path in enumerate(paths):
        if path.is_symlink():
            states[path] = ("link", os.readlink(path))
        elif path.is_dir():
            copy = backup / str(index)
            shutil.copytree(path, copy, symlinks=True)
            states[path] = ("dir", copy)
        elif path.exists():
            copy = backup / str(index)
            shutil.copy2(path, copy)
            states[path] = ("file", copy)
        else:
            states[path] = ("missing", None)
    return (root / "link-skills.sh").read_text(encoding="utf-8"), states


def _restore_operation_state(root: Path, snapshot: tuple[str, dict[Path, tuple[str, object]]]) -> None:
    script, states = snapshot
    (root / "link-skills.sh").write_text(script, encoding="utf-8")
    for path, (kind, value) in states.items():
        if path.is_symlink() or path.is_file():
            path.unlink()
        elif path.is_dir():
            shutil.rmtree(path)
        if kind == "link":
            path.symlink_to(str(value))
        elif kind == "dir":
            shutil.copytree(Path(value), path, symlinks=True)
        elif kind == "file":
            shutil.copy2(Path(value), path)


def run_operations(
    root: Path,
    operations: object,
    source: str = "cli",
    synchronize=None,
) -> dict[str, object]:
    if source not in {"cli", "agent"}:
        raise SkillVisibilityError(f"未対応の操作元です: {source}")
    synchronize = synchronize or _default_synchronize
    validated = validate_operations(operations)
    before_plan = _state_fingerprint(root)
    backup = Path(tempfile.mkdtemp(prefix=".skill-visibility-plan-", dir=root))
    results = []
    try:
        snapshot = _snapshot_operation_state(root, validated, backup)
        for operation in validated:
            before = _state_fingerprint(root)
            try:
                action = operation["action"]
                if action == "enable":
                    enable(root, str(operation["agent"]), str(operation["skill"]), synchronize)
                elif action == "disable":
                    disable(root, str(operation["agent"]), str(operation["skill"]), synchronize)
                elif action == "delete":
                    delete_agent_skill(
                        root, str(operation["agent"]), str(operation["skill"]), synchronize
                    )
                elif action == "delete-canonical":
                    delete_canonical_skill(root, str(operation["skill"]), synchronize)
                elif action == "promote":
                    promote(
                        root,
                        str(operation["agent"]),
                        str(operation["skill"]),
                        bool(operation.get("keep_divergent", False)),
                        synchronize,
                    )
                else:
                    _default_audit(root)
            except (SkillVisibilityError, subprocess.CalledProcessError) as error:
                results.append(
                    {
                        "operation": operation,
                        "ok": False,
                        "error": str(error),
                        "state_preserved": before == _state_fingerprint(root),
                    }
                )
                break
            results.append({"operation": operation, "ok": True, "error": None, "state_preserved": True})
        succeeded = len(results) == len(validated) and all(item["ok"] for item in results)
        if not succeeded:
            _restore_operation_state(root, snapshot)
            for result in results:
                result["state_preserved"] = before_plan == _state_fingerprint(root)
    finally:
        shutil.rmtree(backup, ignore_errors=True)
    audit = (
        {"ok": succeeded, "detail": "audit OK" if succeeded else "operation failed"}
        if validated
        else {"ok": None, "detail": "not run"}
    )
    return {
        "source": source,
        "status": "succeeded" if succeeded else "failed",
        "operations": results,
        "matrix": matrix_to_json(build_matrix(root)),
        "audit": audit,
    }


def parse_plan(text: str) -> dict[str, object]:
    decoder = json.JSONDecoder()
    for index, character in enumerate(text):
        if character != "{":
            continue
        try:
            candidate, _ = decoder.raw_decode(text[index:])
        except json.JSONDecodeError:
            continue
        if isinstance(candidate, dict) and "operations" in candidate:
            operations = validate_operations(candidate["operations"])
            explanation = candidate.get("explanation", "")
            if not isinstance(explanation, str):
                raise SkillVisibilityError("Agent計画の explanation は文字列である必要があります")
            return {"operations": operations, "explanation": explanation}
    raise SkillVisibilityError("Agentの回答から計画JSONを読み取れませんでした")


def agent_command(backend: str, temporary: Path, schema: Path) -> list[str]:
    if backend == "codex":
        return [
            "codex",
            "exec",
            "--sandbox",
            "read-only",
            "--ignore-user-config",
            "--ignore-rules",
            "--ephemeral",
            "--skip-git-repo-check",
            "-C",
            str(temporary),
            "--output-schema",
            str(schema),
            "-",
        ]
    if backend == "claude":
        return [
            "claude",
            "-p",
            "--safe-mode",
            "--tools",
            "",
            "--strict-mcp-config",
            "--no-session-persistence",
            "--disable-slash-commands",
            "--output-format",
            "text",
            "--json-schema",
            json.dumps(PLAN_SCHEMA, ensure_ascii=False),
        ]
    raise SkillVisibilityError(f"未対応の Agent backend です: {backend}")


def propose_operations(
    root: Path,
    backend: str,
    request: str,
    runner=subprocess.run,
) -> dict[str, object]:
    before = _state_fingerprint(root)
    matrix = json.dumps(matrix_to_json(build_matrix(root)), ensure_ascii=False)
    prompt = (
        "次のSkill可視性matrixと依頼から、変更計画だけをJSONで返してください。"
        "ファイルや外部サービスへアクセスせず、推測でSkill名を作らないでください。"
        "形式は operations と explanation。actionはenable/disable/promote/delete/delete-canonical/auditのみです。\n"
        f"matrix: {matrix}\n依頼: {request}"
    )
    with tempfile.TemporaryDirectory(prefix="skill-visibility-agent-") as directory:
        temporary = Path(directory)
        schema = temporary / "plan-schema.json"
        schema.write_text(json.dumps(PLAN_SCHEMA), encoding="utf-8")
        result = runner(
            agent_command(backend, temporary, schema),
            cwd=temporary,
            input=prompt,
            text=True,
            capture_output=True,
            timeout=180,
        )
    if before != _state_fingerprint(root):
        raise SkillVisibilityError("Agent実行中にSkill状態が変更されたため計画を破棄しました")
    if result.returncode:
        raise SkillVisibilityError(result.stderr.strip() or "Agent計画の生成に失敗しました")
    return parse_plan(result.stdout)


def _default_synchronize(root: Path) -> None:
    env = os.environ.copy()
    env["DOTFILES"] = str(root)
    for arguments in ([str(root / "link-skills.sh")], [str(root / "link-skills.sh"), "--audit"]):
        result = subprocess.run(arguments, cwd=root, env=env, text=True, capture_output=True)
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip()
            raise SkillVisibilityError(detail or "link-skills.sh に失敗しました")


def _restore_link(path: Path, old_target: str | None) -> None:
    if path.is_symlink():
        path.unlink()
    if old_target is not None:
        path.symlink_to(old_target)


def enable(root: Path, agent: str, name: str, synchronize=_default_synchronize) -> None:
    _validate(root, agent, name)
    canonical = root / "skills" / name
    target = root / agent / "skills" / name
    if not (canonical / "SKILL.md").is_file():
        raise SkillVisibilityError(f"正本に Skill がありません: {name}")
    if target.exists() and not target.is_symlink():
        raise SkillVisibilityError(f"agent 固有 Skill が存在します。先に promote してください: {target}")
    script = root / "link-skills.sh"
    old_script = script.read_text(encoding="utf-8")
    old_target = os.readlink(target) if target.is_symlink() else None
    declarations = read_declarations(script)[AGENT_ARRAYS[agent]]
    _write_declaration(script, AGENT_ARRAYS[agent], declarations + [name])
    try:
        synchronize(root)
    except Exception:
        script.write_text(old_script, encoding="utf-8")
        _restore_link(target, old_target)
        raise


def disable(root: Path, agent: str, name: str, synchronize=_default_synchronize) -> None:
    _validate(root, agent, name)
    target = root / agent / "skills" / name
    if target.exists() and not target.is_symlink():
        raise SkillVisibilityError(f"agent 固有 Skill は直接オフにできません。先に promote してください: {target}")
    script = root / "link-skills.sh"
    old_script = script.read_text(encoding="utf-8")
    old_target = os.readlink(target) if target.is_symlink() else None
    declarations = read_declarations(script)[AGENT_ARRAYS[agent]]
    _write_declaration(script, AGENT_ARRAYS[agent], [item for item in declarations if item != name])
    if target.is_symlink():
        target.unlink()
    try:
        synchronize(root)
    except Exception:
        script.write_text(old_script, encoding="utf-8")
        _restore_link(target, old_target)
        raise


def delete_agent_skill(
    root: Path,
    agent: str,
    name: str,
    synchronize=_default_synchronize,
) -> None:
    _validate(root, agent, name)
    target = root / agent / "skills" / name
    if target.is_symlink() or not (target / "SKILL.md").is_file():
        raise SkillVisibilityError(f"削除できる agent 固有 Skill がありません: {target}")
    script = root / "link-skills.sh"
    old_script = script.read_text(encoding="utf-8")
    declarations = read_declarations(script)[AGENT_ARRAYS[agent]]
    backup_root = Path(tempfile.mkdtemp(prefix=".skill-visibility-delete-", dir=root))
    backup = backup_root / name
    try:
        _write_declaration(script, AGENT_ARRAYS[agent], [item for item in declarations if item != name])
        target.rename(backup)
        synchronize(root)
    except Exception:
        script.write_text(old_script, encoding="utf-8")
        if target.is_symlink() or target.is_file():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        if backup.exists():
            backup.rename(target)
        raise
    finally:
        shutil.rmtree(backup_root, ignore_errors=True)


def delete_canonical_skill(
    root: Path,
    name: str,
    synchronize=_default_synchronize,
) -> None:
    _validate_skill(root, name)
    canonical = root / "skills" / name
    if canonical.is_symlink() or not (canonical / "SKILL.md").is_file():
        raise SkillVisibilityError(f"削除できる正本 Skill がありません: {canonical}")
    canonical_target = canonical.resolve(strict=True)
    links = {}
    for agent in AGENT_ARRAYS:
        path = root / agent / "skills" / name
        if not path.is_symlink():
            continue
        try:
            points_to_canonical = path.resolve(strict=True) == canonical_target
        except FileNotFoundError:
            points_to_canonical = False
        if not points_to_canonical:
            raise SkillVisibilityError(f"正本を指さない symlink は削除できません: {path}")
        links[path] = os.readlink(path)

    script = root / "link-skills.sh"
    old_script = script.read_text(encoding="utf-8")
    backup_root = Path(tempfile.mkdtemp(prefix=".skill-visibility-delete-canonical-", dir=root))
    backup = backup_root / name
    try:
        for array_name in AGENT_ARRAYS.values():
            declarations = read_declarations(script)[array_name]
            _write_declaration(script, array_name, [item for item in declarations if item != name])
        canonical.rename(backup)
        for path in links:
            path.unlink()
        synchronize(root)
    except Exception:
        script.write_text(old_script, encoding="utf-8")
        if canonical.is_symlink() or canonical.is_file():
            canonical.unlink()
        elif canonical.is_dir():
            shutil.rmtree(canonical)
        if backup.exists():
            backup.rename(canonical)
        for path, target in links.items():
            if path.is_symlink():
                path.unlink()
            if not path.exists():
                path.symlink_to(target)
        raise
    finally:
        shutil.rmtree(backup_root, ignore_errors=True)


def promote(
    root: Path,
    agent: str,
    name: str,
    keep_divergent: bool,
    synchronize=_default_synchronize,
) -> None:
    _validate(root, agent, name)
    canonical = root / "skills" / name
    source = root / agent / "skills" / name
    other_agent = next(item for item in AGENT_ARRAYS if item != agent)
    other = root / other_agent / "skills" / name
    if canonical.exists() or canonical.is_symlink():
        raise SkillVisibilityError(f"正本がすでに存在します: {canonical}")
    if source.is_symlink() or not (source / "SKILL.md").is_file():
        raise SkillVisibilityError(f"昇格できる agent 固有 Skill がありません: {source}")
    other_is_real = other.exists() and not other.is_symlink()
    differences = differing_skill_files(source, other) if other_is_real else []
    identical_other = other_is_real and not differences
    if other_is_real and not identical_other and not keep_divergent:
        raise PromotionConflict(
            f"{other_agent} に同名で内容の異なる Skill があります。"
            f"差分: {', '.join(differences)}。"
            "選択元を確認し、保持するなら --keep-divergent を付けてください"
        )

    script = root / "link-skills.sh"
    old_script = script.read_text(encoding="utf-8")
    backup_root = Path(tempfile.mkdtemp(prefix=".skill-visibility-", dir=root))
    backup_other = backup_root / "other"
    moved_other = False
    try:
        source.rename(canonical)
        agents_to_link = [agent]
        if identical_other:
            other.rename(backup_other)
            moved_other = True
            agents_to_link.append(other_agent)
        for linked_agent in agents_to_link:
            array_name = AGENT_ARRAYS[linked_agent]
            declarations = read_declarations(script)[array_name]
            _write_declaration(script, array_name, declarations + [name])
        synchronize(root)
    except Exception:
        script.write_text(old_script, encoding="utf-8")
        for linked_agent in AGENT_ARRAYS:
            path = root / linked_agent / "skills" / name
            if path.is_symlink():
                path.unlink()
        if canonical.exists():
            canonical.rename(source)
        if moved_other and backup_other.exists():
            backup_other.rename(other)
        raise
    finally:
        shutil.rmtree(backup_root, ignore_errors=True)


def _print_matrix(root: Path) -> None:
    rows = build_matrix(root)
    headers = ("SKILL", "CANONICAL", "CLAUDE", "CODEX", "OWNER", "CREATED", "MODIFIED")
    values = [headers] + [
        (
            row.name,
            "yes" if row.canonical else "no",
            row.claude,
            row.codex,
            row.owner,
            row.created,
            row.modified,
        )
        for row in rows
    ]
    widths = [max(len(row[index]) for row in values) for index in range(len(headers))]
    for index, row in enumerate(values):
        print("  ".join(value.ljust(widths[column]) for column, value in enumerate(row)).rstrip())
        if index == 0:
            print("  ".join("-" * width for width in widths))


def _tui_text(screen, row: int, column: int, text: str, width: int, attribute=0) -> None:
    if row < 0 or width <= 0:
        return
    try:
        screen.addnstr(row, column, text, width, attribute)
    except Exception:
        pass


def prompt_action(key: object) -> str:
    if key in (27, "\x1b"):
        return "cancel"
    if key in (10, 13, "\n", "\r"):
        return "submit"
    if key in (8, 127, "\b", "\x7f"):
        return "backspace"
    return "append"


def status_color_pair(status: str) -> int:
    return STATUS_COLOR_PAIRS.get(status, 0)


def _init_tui_colors(curses) -> None:
    if not curses.has_colors():
        return
    curses.start_color()
    try:
        curses.use_default_colors()
        background = -1
    except curses.error:
        background = curses.COLOR_BLACK
    for pair, foreground in (
        (1, curses.COLOR_CYAN),
        (2, curses.COLOR_GREEN),
        (3, curses.COLOR_YELLOW),
        (4, curses.COLOR_RED),
    ):
        curses.init_pair(pair, foreground, background)


def _tui_prompt(screen, label: str) -> str | None:
    import curses

    height, width = screen.getmaxyx()
    screen.timeout(-1)
    value = ""
    try:
        curses.curs_set(1)
        while True:
            screen.move(height - 1, 0)
            screen.clrtoeol()
            _tui_text(screen, height - 1, 0, f"{label}{value}", width - 1)
            key = screen.get_wch()
            action = (
                "submit"
                if key == curses.KEY_ENTER
                else "backspace"
                if key == curses.KEY_BACKSPACE
                else prompt_action(key)
            )
            if action == "cancel":
                return None
            if action == "submit":
                return value
            if action == "backspace":
                value = value[:-1]
            elif isinstance(key, str) and key.isprintable():
                value += key
    finally:
        curses.curs_set(0)
        screen.timeout(100)


def _tui_result_message(result: dict[str, object]) -> str:
    if result["status"] == "succeeded":
        if not result["operations"]:
            return "変更はありません"
        return f"完了: {len(result['operations'])}操作 / audit OK"
    failed = next((item for item in result["operations"] if not item["ok"]), None)
    return f"失敗: {failed['error'] if failed else 'unknown error'}"


def _draw_tui(
    screen,
    rows: list[MatrixRow],
    selected: int,
    query: str,
    selected_agent: str,
    backend: str,
    message: str,
    pending: dict[str, object] | None,
    agent_running: bool,
    description: str,
) -> None:
    import curses

    screen.erase()
    height, width = screen.getmaxyx()
    color = curses.color_pair if curses.has_colors() else lambda _pair: 0
    if height < 9 or width < 90:
        _tui_text(screen, 0, 0, "画面が小さすぎます (90x9以上にしてください)", width - 1)
        screen.refresh()
        return
    state = "Agentに相談中（一覧操作は継続可能）" if agent_running else message
    state_rows = bool(state)
    title = f"Skill Visibility  操作対象={selected_agent}  相談先={backend}  絞込={query or '-'}"
    _tui_text(screen, 0, 0, title, width - 1, color(1) | curses.A_BOLD)
    skill_width = max(12, width - 78)
    header = (
        f"{'SKILL':<{skill_width}}  {'CANONICAL':<9}  {'CLAUDE':<14}  {'CODEX':<14}  "
        f"{'OWNER':<8}  {'CREATED':<10}  {'MODIFIED':<10}"
    )
    _tui_text(screen, 1, 0, header, width - 1, color(1) | curses.A_UNDERLINE)
    body_height = height - 6 - state_rows
    start = max(0, selected - body_height + 1)
    for screen_row, (index, row) in enumerate(enumerate(rows[start : start + body_height], start), 2):
        line = (
            f"{row.name:<{skill_width}.{skill_width}}  "
            f"{('yes' if row.canonical else 'no'):<9}  {row.claude:<14.14}  {row.codex:<14.14}  "
            f"{row.owner:<8.8}  {row.created:<10.10}  {row.modified:<10.10}"
        )
        attribute = curses.A_REVERSE if index == selected else 0
        _tui_text(screen, screen_row, 0, line, width - 1, attribute)
        canonical_column = skill_width + 2
        claude_column = canonical_column + 11
        codex_column = claude_column + 16
        owner_column = codex_column + 16
        canonical_attribute = (color(2) if row.canonical else curses.A_DIM) | attribute
        _tui_text(
            screen,
            screen_row,
            canonical_column,
            f"{'yes' if row.canonical else 'no':<9}",
            9,
            canonical_attribute,
        )
        for column, status in ((claude_column, row.claude), (codex_column, row.codex)):
            pair = status_color_pair(status)
            status_attribute = (color(pair) if pair else curses.A_DIM) | attribute
            _tui_text(screen, screen_row, column, f"{status:<14.14}", 14, status_attribute)
        owner_pair = 3 if row.owner == "agent" else 1 if row.owner == "user" else 0
        _tui_text(
            screen,
            screen_row,
            owner_column,
            f"{row.owner:<8.8}",
            8,
            (color(owner_pair) if owner_pair else curses.A_DIM) | attribute,
        )
    description_row = height - 4 - state_rows
    _tui_text(screen, description_row, 0, "説明:", 5, color(1) | curses.A_BOLD)
    for offset, line in enumerate(description_lines(description, width - 7, 2)):
        _tui_text(screen, description_row + offset, 6, line, width - 7)
    state_pair = 3 if agent_running else 4 if "失敗" in state or "開けません" in state else 2 if state.startswith(("完了", "VS Codeで開きました")) else 0
    _tui_text(screen, height - 3, 0, state, width - 1, color(state_pair))
    if pending:
        operations = ", ".join(
            f"{item['action']}:{item.get('agent', '-')}:{item.get('skill', '-')}"
            for item in pending["operations"]
        )
        _tui_text(
            screen,
            height - 2,
            0,
            f"計画: {operations or '変更なし'}  Enter=実行 Esc=取消",
            width - 1,
            color(3),
        )
    else:
        _tui_text(
            screen,
            height - 2,
            0,
            "j/k=行 ^d/^u=半頁 gg/G=端 Tab=対象 /=検索 o=開く b=Agent切替 r=更新 c=解除",
            width - 1,
            curses.A_DIM,
        )
    _tui_text(
        screen,
        height - 1,
        0,
        "e/d=追加/オフ p/P=昇格/差分 x/X=固有/正本削除 a=監査 :=自然文で操作 q=終了",
        width - 1,
        curses.A_DIM,
    )
    screen.refresh()


def _run_tui(root: Path, backend: str) -> None:
    import curses
    from concurrent.futures import ThreadPoolExecutor

    def application(screen) -> None:
        nonlocal backend
        curses.curs_set(0)
        _init_tui_colors(curses)
        screen.keypad(True)
        screen.timeout(100)
        rows = build_matrix(root)
        query = ""
        selected = 0
        selected_agent = "claude"
        message = ""
        pending = None
        future = None
        waiting_for_g = False
        descriptions: dict[Path, str] = {}
        with ThreadPoolExecutor(max_workers=1) as executor:
            while True:
                visible = filter_rows(rows, query)
                selected = min(selected, max(0, len(visible) - 1))
                if visible:
                    folder = skill_folder(root, visible[selected], selected_agent)
                    if folder not in descriptions:
                        descriptions[folder] = read_skill_description(folder)
                    description = descriptions[folder]
                else:
                    description = "該当するSkillがありません"
                if future and future.done():
                    try:
                        plan = future.result()
                        pending = {
                            "operations": plan["operations"],
                            "explanation": plan["explanation"],
                            "source": "agent",
                            "fingerprint": _state_fingerprint(root),
                        }
                        message = str(plan["explanation"] or "Agentが計画を返しました")
                    except Exception as error:
                        message = f"Agent失敗: {error}"
                    future = None
                _draw_tui(
                    screen,
                    visible,
                    selected,
                    query,
                    selected_agent,
                    backend,
                    message,
                    pending,
                    future is not None,
                    description,
                )
                key = screen.getch()
                if key == -1:
                    continue
                jump, waiting_for_g = vim_jump(key, waiting_for_g, len(visible))
                if jump is not None:
                    selected = jump
                    continue
                if key == ord("g"):
                    continue
                if key in (ord("q"), ord("Q")):
                    if future:
                        message = "Agentに相談中は完了を待ってから終了してください"
                        continue
                    return
                if key in (curses.KEY_UP, ord("k")):
                    selected = max(0, selected - 1)
                    continue
                if key in (curses.KEY_DOWN, ord("j")):
                    selected = min(max(0, len(visible) - 1), selected + 1)
                    continue
                if key in (4, 21):
                    selected = page_target(selected, 1 if key == 4 else -1, len(visible), screen.getmaxyx()[0])
                    continue
                if key in (curses.KEY_LEFT, curses.KEY_RIGHT, 9):
                    selected_agent = "codex" if selected_agent == "claude" else "claude"
                    continue
                if key == ord("o") and visible:
                    folder = skill_folder(root, visible[selected], selected_agent)
                    try:
                        subprocess.run(
                            ["code", str(folder)],
                            check=True,
                            stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE,
                            text=True,
                        )
                        message = f"VS Codeで開きました: {folder}"
                    except (OSError, subprocess.CalledProcessError) as error:
                        message = f"フォルダを開けませんでした: {error}"
                    continue
                if key == ord("/"):
                    entered = _tui_prompt(screen, "検索: ")
                    if entered is None:
                        message = "検索を取り消しました"
                    else:
                        query = entered.strip()
                        selected = 0
                    continue
                if key == ord("c"):
                    query = ""
                    selected = 0
                    continue
                if key == ord("r"):
                    rows = build_matrix(root)
                    descriptions.clear()
                    message = "一覧を更新しました"
                    continue
                if key == ord("b"):
                    if future:
                        message = "Agentに相談中は相談先を変更できません"
                    else:
                        backend = "claude" if backend == "codex" else "codex"
                        message = f"相談先を{backend}へ変更しました"
                    continue
                if key == ord(":"):
                    if future:
                        message = "Agentに相談中です"
                        continue
                    entered = _tui_prompt(screen, "自然文で操作: ")
                    if entered is None:
                        message = "Agent相談を取り消しました"
                        continue
                    request = entered.strip()
                    if request:
                        future = executor.submit(propose_operations, root, backend, request)
                        message = "Agentに相談しました"
                    continue
                if key == 27 and pending:
                    pending = None
                    message = "計画を取り消しました"
                    continue
                if key in (10, 13, curses.KEY_ENTER) and pending:
                    if pending["fingerprint"] != _state_fingerprint(root):
                        rows = build_matrix(root)
                        pending = None
                        message = "状態が変わったため計画を取り消しました。再選択してください"
                        continue
                    result = run_operations(root, pending["operations"], source=str(pending["source"]))
                    rows = build_matrix(root)
                    pending = None
                    message = _tui_result_message(result)
                    continue
                if key == ord("a"):
                    pending = {
                        "operations": [{"action": "audit"}],
                        "source": "cli",
                        "fingerprint": _state_fingerprint(root),
                    }
                    message = "監査を実行します"
                    continue
                if key == ord("X") and visible:
                    row = visible[selected]
                    if not row.canonical:
                        message = f"{row.name} に削除できる正本はありません"
                        continue
                    pending = {
                        "operations": [{"action": "delete-canonical", "skill": row.name}],
                        "source": "cli",
                        "fingerprint": _state_fingerprint(root),
                    }
                    message = f"{row.name} の正本と全symlinkを完全に削除します"
                    continue
                if key not in (ord("e"), ord("d"), ord("p"), ord("P"), ord("x")) or not visible:
                    continue
                action = {
                    ord("e"): "enable",
                    ord("d"): "disable",
                    ord("p"): "promote",
                    ord("P"): "promote",
                    ord("x"): "delete",
                }[key]
                row = visible[selected]
                if action not in actions_for(row, selected_agent):
                    message = f"{row.name} は {selected_agent} で {action} できません"
                    continue
                operation: dict[str, object] = {
                    "action": action,
                    "agent": selected_agent,
                    "skill": row.name,
                }
                if key == ord("P"):
                    operation["keep_divergent"] = True
                pending = {
                    "operations": [operation],
                    "source": "cli",
                    "fingerprint": _state_fingerprint(root),
                }
                message = (
                    f"{row.name} を {selected_agent} から完全に削除します"
                    if action == "delete"
                    else f"{row.name} の {action} を確認してください"
                )

    curses.wrapper(application)


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dotfiles",
        type=Path,
        default=Path(os.environ.get("DOTFILES", Path.home() / "dotfiles")),
    )
    subparsers = parser.add_subparsers(dest="command", required=True)
    listing = subparsers.add_parser("list", help="正本と agent ごとの可視性を一覧表示")
    listing.add_argument("--json", action="store_true")
    audit_parser = subparsers.add_parser("audit", help="宣言と symlink の一致を監査")
    audit_parser.add_argument("--json", action="store_true")
    for command in ("enable", "disable"):
        action = subparsers.add_parser(command)
        action.add_argument("agent", choices=AGENT_ARRAYS)
        action.add_argument("skill")
        action.add_argument("--json", action="store_true")
    action = subparsers.add_parser("delete", help="agent 固有 Skill を削除")
    action.add_argument("agent", choices=AGENT_ARRAYS)
    action.add_argument("skill")
    action.add_argument("--yes", action="store_true", required=True)
    action.add_argument("--json", action="store_true")
    action = subparsers.add_parser("delete-canonical", help="正本と正本 symlink を削除")
    action.add_argument("skill")
    action.add_argument("--yes", action="store_true", required=True)
    action.add_argument("--json", action="store_true")
    action = subparsers.add_parser("promote")
    action.add_argument("agent", choices=AGENT_ARRAYS, help="正本として採用する側")
    action.add_argument("skill")
    action.add_argument("--keep-divergent", action="store_true")
    action.add_argument("--json", action="store_true")
    tui = subparsers.add_parser("tui", help="対話画面で一覧・変更・Agent相談を行う")
    tui.add_argument("--agent", choices=("codex", "claude"), default="codex")
    return parser


def main() -> int:
    arguments = _parser().parse_args()
    root = arguments.dotfiles.expanduser().resolve()
    try:
        if arguments.command == "tui":
            _run_tui(root, arguments.agent)
            return 0
        if getattr(arguments, "json", False):
            if arguments.command == "list":
                result = run_operations(root, [])
            elif arguments.command == "audit":
                result = run_operations(root, [{"action": "audit"}])
            else:
                operation = {"action": arguments.command, "skill": arguments.skill}
                if arguments.command != "delete-canonical":
                    operation["agent"] = arguments.agent
                if arguments.command == "promote":
                    operation["keep_divergent"] = arguments.keep_divergent
                result = run_operations(root, [operation])
            print(json.dumps(result, ensure_ascii=False))
            return 0 if result["status"] == "succeeded" else 1
        if arguments.command == "list":
            _print_matrix(root)
        elif arguments.command == "audit":
            env = os.environ.copy()
            env["DOTFILES"] = str(root)
            subprocess.run([str(root / "link-skills.sh"), "--audit"], cwd=root, env=env, check=True)
        elif arguments.command == "enable":
            enable(root, arguments.agent, arguments.skill)
            _print_matrix(root)
        elif arguments.command == "disable":
            disable(root, arguments.agent, arguments.skill)
            _print_matrix(root)
        elif arguments.command == "promote":
            promote(root, arguments.agent, arguments.skill, arguments.keep_divergent)
            _print_matrix(root)
        elif arguments.command == "delete":
            delete_agent_skill(root, arguments.agent, arguments.skill)
            _print_matrix(root)
        else:
            delete_canonical_skill(root, arguments.skill)
            _print_matrix(root)
    except KeyboardInterrupt:
        return 130
    except (SkillVisibilityError, subprocess.CalledProcessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
