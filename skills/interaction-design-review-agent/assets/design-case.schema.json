{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/interaction-design-review-agent/design-case.schema.json",
  "title": "Interaction Design Review Case",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "pipeline",
    "actors",
    "business_understanding",
    "business_workflow",
    "decision_requirements",
    "target_value_loop",
    "decisions",
    "decision_table",
    "principles",
    "contradictions",
    "state_machine",
    "information_architecture",
    "ui_behaviors",
    "questions",
    "assumptions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "scope",
        "success_conditions"
      ]
    },
    "pipeline": {
      "type": "object",
      "required": [
        "current_stage",
        "stages"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "goal", "authority", "responsibilities"]
      }
    },
    "business_understanding": {
      "type": "object",
      "required": ["purpose", "scope_in", "scope_out", "pain_points", "teach_back"]
    },
    "business_workflow": {
      "type": "object",
      "required": ["start_event", "start_step_id", "end_event", "steps"]
    },
    "decision_requirements": {
      "type": "object",
      "required": ["confirmed_none", "items"]
    },
    "target_value_loop": {
      "type": "object",
      "required": ["start_event", "start_step_id", "value_outcome", "steps"]
    },
    "decisions": {
      "type": "array"
    },
    "decision_table": {
      "type": "object"
    },
    "principles": {
      "type": "array"
    },
    "contradictions": {
      "type": "array"
    },
    "state_machine": {
      "type": "object"
    },
    "information_architecture": {
      "type": "object"
    },
    "ui_behaviors": {
      "type": "array"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "question",
          "priority",
          "reason",
          "status",
          "answer"
        ],
        "properties": {
          "answer_type": {
            "enum": ["yes_no", "single_choice", "free_text"]
          },
          "recommended_answer": {
            "type": "string"
          },
          "recommendation_reason": {
            "type": "string"
          },
          "answer_guide": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "open"
                }
              },
              "required": ["status"]
            },
            "then": {
              "required": [
                "answer_type",
                "recommended_answer",
                "recommendation_reason",
                "answer_guide"
              ]
            }
          }
        ]
      }
    },
    "assumptions": {
      "type": "array"
    },
    "traceability": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
